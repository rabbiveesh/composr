#!/usr/bin/env bash
# Back-compat shim. The hook logic now lives in the `composr` binary as
# `composr git-hook <label>` — this script just forwards to it so any
# existing hook files calling `_composr_git_hook` keep working.
#
# New hook files should call `composr git-hook <label>` directly and skip
# this script entirely (one less thing to install on $PATH).

set -u

label="${1:?label required}"
composr="${COMPOSR:-composr}"
if ! command -v "$composr" >/dev/null 2>&1; then
    exit 0
fi
exec "$composr" git-hook "$label"
