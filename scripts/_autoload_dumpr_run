#!/usr/bin/env bash
# Run `composr dump-autoload --emit-stats` with a styled "starting…" line
# up front so the user knows something is happening. The pretty-printer
# overwrites that line in place with the result when the JSON stats
# arrive, leaving a single clean line in the terminal.
#
# Usage:
#   _autoload_dumpr_run <label> [composr dump-autoload args...]

set -u

label="${1:?label required}"
shift

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    DIM=$'\033[2m'
    CYAN_B=$'\033[1;36m'
    RESET=$'\033[0m'
else
    DIM="" CYAN_B="" RESET=""
fi

printf '%s[%s]%s  %sautoload%s %sstarting…%s\n' \
    "$DIM" "$label" "$RESET" \
    "$CYAN_B" "$RESET" \
    "$DIM" "$RESET" >&2

# Binary resolution: $COMPOSR (modern), then `composr` on PATH.
bin="${COMPOSR:-composr}"
if ! command -v "$bin" >/dev/null 2>&1; then
    exit 0
fi

# `2>&1` so warnings flow through the formatter (which prints them through
# unchanged); `|| true` so a non-zero exit from the dump never breaks the
# calling git op or wrapper.
"$bin" dump-autoload --emit-stats "$@" 2>&1 | _autoload_dumpr_pretty "$label" || true
