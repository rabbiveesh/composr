#!/usr/bin/env bash
# Pretty-prints the JSON stats line emitted by `autoload-dumpr --emit-stats`.
#
# Usage:
#   autoload-dumpr --emit-stats 2>&1 | _autoload_dumpr_pretty <label>
#
# <label> is shown in dim brackets at the start of the line (e.g. the name of
# the git hook or wrapper that invoked the dump). Lines that aren't the JSON
# stats line are passed through to stderr unchanged so warnings still surface.
#
# Honors NO_COLOR and only colors when stderr is a TTY.

set -u

label="${1:-autoload-dumpr}"

if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
    C_RESET=$'\033[0m'
    C_DIM=$'\033[2m'
    C_CYAN_B=$'\033[1;36m'
    C_GREEN=$'\033[32m'
    C_GREEN_B=$'\033[1;32m'
    C_BGREEN=$'\033[92m'
    C_YELLOW=$'\033[33m'
    C_YELLOW_B=$'\033[1;33m'
    C_RED=$'\033[31m'
    C_RED_B=$'\033[1;31m'
    # Cursor up one line + clear it + return to col 0. Used to overwrite the
    # "starting…" preamble printed by `_autoload_dumpr_run` so the final
    # terminal state is one line, not two. Suppressed if any passthrough
    # output (e.g. tracing warnings) printed in between, since we would
    # otherwise clobber genuine output.
    C_CLEAR_PREV=$'\033[1A\033[2K\r'
else
    C_RESET="" C_DIM="" C_CYAN_B="" C_GREEN="" C_GREEN_B=""
    C_BGREEN="" C_YELLOW="" C_YELLOW_B="" C_RED="" C_RED_B=""
    C_CLEAR_PREV=""
fi

awk \
    -v label="$label" \
    -v RESET="$C_RESET" -v DIM="$C_DIM" -v CYAN_B="$C_CYAN_B" \
    -v GREEN="$C_GREEN" -v GREEN_B="$C_GREEN_B" -v BGREEN="$C_BGREEN" \
    -v YELLOW="$C_YELLOW" -v YELLOW_B="$C_YELLOW_B" \
    -v RED="$C_RED" -v RED_B="$C_RED_B" \
    -v CLEAR_PREV="$C_CLEAR_PREV" '
function commas(n,    s, r) {
    s = sprintf("%d", n); r = ""
    while (length(s) > 3) {
        r = "," substr(s, length(s) - 2) r
        s = substr(s, 1, length(s) - 3)
    }
    return s r
}
/"elapsed_ms":/ {
    match($0, /"walked":[0-9]+/);     walked  = substr($0, RSTART+9,  RLENGTH-9)+0
    match($0, /"hits":[0-9]+/);       hits    = substr($0, RSTART+7,  RLENGTH-7)+0
    match($0, /"misses":[0-9]+/);     misses  = substr($0, RSTART+9,  RLENGTH-9)+0
    match($0, /"errors":[0-9]+/);     errors  = substr($0, RSTART+9,  RLENGTH-9)+0
    match($0, /"classes":[0-9]+/);    classes = substr($0, RSTART+10, RLENGTH-10)+0
    match($0, /"elapsed_ms":[0-9]+/); elapsed = substr($0, RSTART+13, RLENGTH-13)+0

    speed = (elapsed >= 1000) ? sprintf("%.1fs", elapsed / 1000) : (elapsed "ms")

    # A 100% cache hit is the happy path regardless of absolute time — the
    # floor is inherent (we still stat every file). No yellow speed just
    # because the repo is large.
    if (errors > 0) {
        word = "bumpy";     wc = RED_B
        sc  = RED
        extra = errors " errors"; ec = RED
    } else if (walked > 0 && misses == 0) {
        word = "blazing";   wc = GREEN_B
        sc  = (elapsed < 800 ? BGREEN : GREEN)
        extra = "100% cache hot"; ec = GREEN
    } else if (hits > 0 && misses > 0) {
        word = "refreshed"; wc = GREEN_B
        sc  = (elapsed < 3000 ? GREEN : YELLOW)
        extra = commas(misses) " reparsed / " commas(hits) " cached"; ec = YELLOW
    } else {
        word = "rebuilt";   wc = YELLOW_B
        sc  = (elapsed < 5000 ? YELLOW : RED)
        extra = commas(misses) " files reparsed"; ec = YELLOW
    }

    clear = (passthrough == 0 ? CLEAR_PREV : "")
    printf "%s%s[%s]%s  %sautoload%s %s%s%s  %s·%s  %s%s%s  %s·%s  %s%s%s  %s·%s  %s%s classes%s\n", \
        clear, \
        DIM, label, RESET, \
        CYAN_B, RESET, \
        wc, word, RESET, \
        DIM, RESET, \
        sc, speed, RESET, \
        DIM, RESET, \
        ec, extra, RESET, \
        DIM, RESET, \
        DIM, commas(classes), RESET > "/dev/stderr"
    next
}
{ print > "/dev/stderr"; passthrough++ }
'
